
# Authentication (Supabase)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=                    # Secret key — backend only, never commit the real value

# Database
DATABASE_URL=postgresql+psycopg2://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Frontend (for CORS)
FRONTEND_URL=http://localhost:5173

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Keep disabled until card consent and Stripe trial activation are connected.
BILLING_ONBOARDING_ENABLED=false
# In-app trial reminders and payment alerts; enable after notification verification.
BILLING_NOTIFICATIONS_ENABLED=false
# Explicit trusted auth user IDs, never agency roles or user metadata.
BILLING_OPERATOR_USER_IDS=[]
STRIPE_STANDARD_MONTHLY_V1_PRICE_ID=
STRIPE_STANDARD_ANNUAL_V1_PRICE_ID=
STRIPE_FOUNDING_MONTHLY_V1_PRICE_ID=

# Error logging (optional, production only)
# BACKEND_SENTRY_DSN=https://...@sentry.io/...
