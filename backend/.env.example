
# Authentication (Supabase)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=                    # Secret key — backend only, never commit the real value

# Database
DATABASE_URL=postgresql+psycopg2://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Enable after the push migration and EAS FCM credentials are deployed and tested.
PUSH_DELIVERY_ENABLED=false
# Use staging on staging, and com.homecareapp.worker on production. JSON array.
PUSH_ALLOWED_APP_IDS=["com.homecareapp.worker.staging"]
# Required when Expo enhanced push security is enabled. Backend only.
EXPO_PUSH_ACCESS_TOKEN=

# Frontend (for CORS)
FRONTEND_URL=http://localhost:5173

# Canadian address suggestions (optional; manual entry works without it).
# Backend only. Use separate keys per environment. Never commit real keys.
GEOAPIFY_API_KEY=
# Shared across accounts in ONE backend process; resets on restart.
# Multiple processes/replicas need a shared persistent budget first.
ADDRESS_LOOKUP_DAILY_LIMIT=2500

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_ACCOUNT_ID=                 # Expected Home Care Management Software account
STRIPE_WEBHOOK_SECRET=whsec_...

# Keep disabled until card consent and Stripe trial activation are connected.
BILLING_ONBOARDING_ENABLED=false
# In-app trial reminders and payment alerts; enable after notification verification.
BILLING_NOTIFICATIONS_ENABLED=false
# Explicit trusted auth user IDs, never agency roles or user metadata.
BILLING_OPERATOR_USER_IDS=[]
# Current prices only; obtain all three from the same Stripe environment as the key.
STRIPE_STANDARD_MONTHLY_PRICE_ID=
STRIPE_STANDARD_ANNUAL_PRICE_ID=
STRIPE_FOUNDING_MONTHLY_PRICE_ID=
STRIPE_STANDARD_ADDITIONAL_CLIENT_PRICE_ID=
STRIPE_FOUNDING_ADDITIONAL_CLIENT_PRICE_ID=
BILLING_USAGE_FINALIZATION_ENABLED=false
BILLING_SETTLEMENT_ENABLED=false
BILLING_SETTLEMENT_LIVE_ENABLED=false
# Explicitly choose none for untaxed sandbox tests or stripe with a tax code.
BILLING_USAGE_TAX_MODE=unconfigured
STRIPE_USAGE_TAX_CODE=

# Error logging (optional, production only)
# BACKEND_SENTRY_DSN=https://...@sentry.io/...
