
VITE_BACKEND_API_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=          # Publishable key only — safe for frontend
VITE_APP_ENV=development

# Monitored public mailbox for worker account/data deletion requests (required before release).
VITE_PRIVACY_CONTACT_EMAIL=

# Worker download links: leave blank until store listings or test distribution exist.
VITE_WORKER_IOS_DOWNLOAD_URL=
VITE_WORKER_ANDROID_DOWNLOAD_URL=

# Stripe (publishable key only — safe for frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Error logging (optional, production only)
# VITE_SENTRY_DSN=https://...@sentry.io/...
